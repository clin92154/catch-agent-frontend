# 四端 Demo 啟動設定；請複製為 .env.demo 後再依本機環境調整。
# .env.demo 已被 .gitignore 排除，不要提交帳密或 API Key。

DEMO_AGENT_BACKEND_PORT=8002
DEMO_AGENT_FRONTEND_PORT=5176
DEMO_CRM_BACKEND_PORT=8011
DEMO_CRM_FRONTEND_PORT=5175

# Agent backend 的既有 .env，內含 CRM_API_ACCOUNT／CRM_API_PASSWORD。
DEMO_AGENT_ENV_FILE=../demo_agent_bot_crm_integrate/.env

# 必須使用包含正確 PII 金鑰的 CRM 測試 env；不可使用正式或 stage env。
DEMO_CRM_ENV_FILE=../aposo_crm_security_refactor/.env.crud-bench
DEMO_CRM_FRONTEND_ENV_FILE=../aposo_crm_frontend_agent_adapter/.env.dev

# 僅允許 dev／demo／test database；預設為合成資料庫。
DEMO_CRM_DATABASE_URL=postgresql://shihtengchang@127.0.0.1:5432/aposo_crm_agent_dev

# Demo 預設不呼叫外部 LLM。若要測試真實 LLM，請另行明確覆寫並確認成本。
DEMO_LLM_MODE=demo

# 若 Agent .env 沒有 CRM_API_ACCOUNT／CRM_API_PASSWORD，可在此填入。
# DEMO_CRM_ADMIN_ACCOUNT=
# DEMO_CRM_ADMIN_PASSWORD=
